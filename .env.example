# Server-only AI credentials and provider settings. Never add the VITE_ prefix to secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional Gemini-compatible key name:
GOOGLE_API_KEY=
AI_PROVIDER=gemini
AI_PROVIDER_FALLBACKS=gemini,openai,anthropic,huggingface

# Optional server-side fallback providers:
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
HF_TOKEN=
HF_MODEL=

# Firebase web app configuration (these values are public client config, not secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional local server settings:
PORT=3000
DISABLE_HMR=false
