# Gemini API key: server-side only; never use the VITE_ prefix for this secret.
GEMINI_API_KEY=
# Default model; override only with a model ID supported by your Gemini API access.
GEMINI_MODEL=gemini-3.8-flash

# Firebase Web App configuration: copy exact values from Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
# Optional: leave blank to use the default Firestore database.
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
