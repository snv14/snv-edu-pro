# ─────────────────────────────────────────────────────────────────────────────
#  snv-edu-pro — إعدادات البيئة
#  انسخ هذا الملف إلى  .env.local  ثم املأ ما تحتاجه فقط.
#
#      cp .env.example .env.local
#
#  ⚠️  .env.local مستثنى من Git (انظر .gitignore) — لا يُرفع أبداً.
#  ⚠️  لا تحتاج أي مفتاح لتشغيل المنصة وقواعدها المنهجية؛ المفاتيح تفتح
#      ميزتين فقط: المزامنة السحابية، والمساعد الذكي.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
#  1) Firebase — المزامنة السحابية (اختياري)
# ─────────────────────────────────────────────────────────────────────────────
#  بدون هذه القيم: كل شيء يعمل، لكن البيانات تبقى في متصفح هذا الجهاز فقط
#  (localStorage + IndexedDB). لا تُفقد عند إغلاق المتصفح، لكنها لا تنتقل
#  إلى جهاز آخر ولا تُستعاد بعد حذف بيانات المتصفح.
#
#  كيف تحصل عليها (5 دقائق، مجاناً):
#    1. https://console.firebase.google.com  ← أنشئ مشروعاً
#    2. Build → Firestore Database → Create database
#       اختر: Production mode  (ثم انشر القواعد من firestore.rules — انظر أدناه)
#    3. Build → Authentication → Sign-in method → فعّل Google
#    4. Project settings (⚙️) → Your apps → Web (</>) → سجّل تطبيقاً
#    5. انسخ قيم firebaseConfig من نافذة التسجيل إلى الأسطر التالية
#
#  ⚠️  هذه المفاتيح عامة بطبيعة الحال (تظهر في حزمة المتصفح) — الحماية
#      الحقيقية تأتي من firestore.rules لا من إخفائها. لكن لا تضع أي مفتاح
#      سِرّي (مثل مفاتيح القسم 2) في متغيّر يبدأ بـ VITE_.
#
#  نشر قواعد الأمان بعد ضبط المشروع:
#      npx firebase-tools login
#      npx firebase-tools deploy --only firestore:rules --project <project-id>
#  أو انسخ محتوى firestore.rules يدوياً إلى تبويب Rules في وحدة التحكم.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

#  اختياري: يُستعمل فقط إن كان مشروعك على قاعدة بيانات مسماة غير (default).
VITE_FIREBASE_DATABASE_ID=


# ═════════════════════════════════════════════════════════════════════════════
#  2) مزوّد الذكاء الاصطناعي — المساعد البيداغوجي (اختياري)
# ─────────────────────────────────────────────────────────────────────────────
#  ⚠️  هذه مفاتيح سِرّية حقيقية: تُستعمل على الخادم فقط، ولا تبدأ بـ VITE_،
#      ولا تظهر في حزمة المتصفح إطلاقاً.
#  بدونها: المساعد الذكي وتحليل المرفقات وتوليد المذكرات معطّلة، وبقية
#  المنصة تعمل طبيعياً.
#
#  المزوّد الأساسي المقترح: Gemini (له طبقة مجانية سخية ويدعم تحليل الصور/PDF)
#      https://aistudio.google.com/apikey
#
#  ملاحظة من الشيفرة (src/server/aiGateway.ts:23, aiGateway.ts:108):
#    • لا يوجد مزود واحد مضبوط ⇒ getAIProviderStatus() ترجع available: []
#      وفهرس المعرفة المحلي يبقى يعمل (البحث/الاستخراج) دون توليد نص.
#    • المرفقات (صور/PDF) لا تُرسَل تلقائياً إلى مزوّد بديل؛ تحتاج Gemini.

GEMINI_API_KEY=
GEMINI_MODEL=

#  ترتيب المزوّدين. الفارغ = الافتراضي: gemini ثم openai ثم anthropic ثم huggingface
AI_PROVIDER=
AI_PROVIDER_FALLBACKS=

#  مزوّدون بديلون (املأ واحداً فقط إن لم تستعمل Gemini)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

HF_TOKEN=
HF_MODEL=


# ═════════════════════════════════════════════════════════════════════════════
#  3) الخادم — ضبط اختياري
# ─────────────────────────────────────────────────────────────────────────────

#  منفذ الخادم. الافتراضي 3000 (وضع التطوير يفرض 3000).
PORT=3000

#  عنوان الاستماع. 0.0.0.0 ضروري للمعاينة الحيّة داخل الحاوية.
HOST=0.0.0.0

#  عدد طلبات /api/gemini المسموح بها لكل IP في الدقيقة. الافتراضي 20.
#  اضبطه فقط إن كنت خلف وكيل عكسي (Nginx / Cloud Run).
AI_RATE_LIMIT_PER_MINUTE=

#  اضبطه على 1 خلف وكيل عكسي، وإلا صار تحديد المعدّل مشتركاً بين كل
#  المستخدمين لأن req.ip يعود دائماً إلى عنوان الوسيط.
TRUST_PROXY=
