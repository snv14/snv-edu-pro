# ==============================================================================
# منصة المذكرة البيداغوجية - علوم الطبيعة والحياة (التعليم المتوسط)
# نموذج متغيرات البيئة - انسخ هذا الملف إلى .env.local وضع قيمك الخاصة
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. إعدادات خادم الذكاء الاصطناعي (AI Providers - Server Side Only)
# تنبيه أمني: تبقى هذه المفاتيح في جانب الخادم فقط ولا تستخدم بادئة VITE_ معها
# ------------------------------------------------------------------------------

# مفتاح Google Gemini الرئيسي (المطلوب لتحليل الصور وPDF والبحث المباشر في الويب)
GEMINI_API_KEY=
# نموذج Gemini الافتراضي المعتمد (افتراضي: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# مزودات بديلة احتياطية اختيارية للأسئلة النصية (عند غياب Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# ترتيب أولوية المزودين (gemini,openai,anthropic,huggingface)
AI_PROVIDER=gemini
AI_PROVIDER_FALLBACKS=gemini,openai,anthropic,huggingface

# ------------------------------------------------------------------------------
# 2. إعدادات خادم التطبيق
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. إعدادات Firebase للمزامنة السحابية والحسابات (Client Side)
# مطلوبة لتفعيل المزامنة السحابية وقاعدة البيانات Firestore
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=