    "@fontsource/tajawal": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "localforage": "^1.10.0",
    "lucide-react": "^0.546.0",
